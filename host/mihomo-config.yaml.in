  geosite-cloudflare:
    type: http
    behavior: domain
    path: ./ruleset/geosite-cloudflare.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/cloudflare.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

# 代理组
proxy-groups:
  - name: "🔰 选择节点"
    type: select
    use: [ikuuu]

  - name: "🇺🇸 美国节点"
    type: select
    use:
      - ikuuu
    filter: "(?i)美国|US|United States|🇺🇸"

  - name: "🇺🇸 AI/Dev"
    type: select
    proxies:
      - "🇺🇸 美国节点"
      - "🔰 选择节点"

  - name: "🌏 爱奇艺&哔哩哔哩"
    type: select
    use: [ikuuu]
    filter: "香港|台湾"
    proxies: ["DIRECT", "🔰 选择节点"]

  - name: "📺 动画疯"
    type: select
    use: [ikuuu]
    filter: "台湾"
    proxies: ["🔰 选择节点", "DIRECT"]

  - name: "🎮 Steam 登录/下载"
    type: select
    proxies: ["DIRECT", "🔰 选择节点"]

  - name: "🎮 Steam 商店/社区"
    type: select
    proxies: ["🔰 选择节点", "DIRECT"]
    
  - name: "🌩️ Cloudflare"
    type: select
    proxies: ["🔰 选择节点", "DIRECT"]

  - name: "☁️ OneDrive"
    type: select
    proxies: ["DIRECT", "🔰 选择节点"]

  - name: "🎓 学术网站"
    type: select
    proxies: ["DIRECT", "🔰 选择节点"]

  - name: "🇨🇳 国内网站"
    type: select
    proxies: ["DIRECT", "🔰 选择节点"]

  - name: "🛑 拦截广告"
    type: select
    proxies: ["REJECT", "DIRECT", "🔰 选择节点"]

  - name: "🐟 漏网之鱼"
    type: select
    proxies: ["🔰 选择节点", "DIRECT"]

rules:
  # ===== 显式直连 =====

  - DOMAIN-SUFFIX,music.163.com,DIRECT
  - DOMAIN-SUFFIX,music.126.net,DIRECT

  - DOMAIN-SUFFIX,no-mad-sub.one,DIRECT
  - DOMAIN-SUFFIX,jsdelivr.net,DIRECT

  - DST-PORT,25,DIRECT
  - DST-PORT,109,DIRECT
  - DST-PORT,110,DIRECT
  - DST-PORT,143,DIRECT
  - DST-PORT,465,DIRECT
  - DST-PORT,587,DIRECT
  - DST-PORT,993,DIRECT
  - DST-PORT,995,DIRECT

  # ===== 去广告 =====

  - RULE-SET,geosite-ads,🛑 拦截广告

  # ===== 关键服务：优先于大型 geosite =====

  # 学术网站
  - DOMAIN-SUFFIX,scholar.google.com,🎓 学术网站
  - DOMAIN-SUFFIX,ieee.org,🎓 学术网站
  - DOMAIN-SUFFIX,acm.org,🎓 学术网站
  - DOMAIN-SUFFIX,arxiv.org,🎓 学术网站
  - DOMAIN-SUFFIX,sci-hub.se,🎓 学术网站
  - DOMAIN-SUFFIX,sci-hub.ru,🎓 学术网站
  - DOMAIN-SUFFIX,springer.com,🎓 学术网站
  - DOMAIN-SUFFIX,elsevier.com,🎓 学术网站
  - DOMAIN-SUFFIX,sciencedirect.com,🎓 学术网站
  - DOMAIN-SUFFIX,nature.com,🎓 学术网站
  - DOMAIN-SUFFIX,science.org,🎓 学术网站
  - DOMAIN-SUFFIX,researchgate.net,🎓 学术网站
  - DOMAIN-SUFFIX,semanticscholar.org,🎓 学术网站
  - DOMAIN-SUFFIX,pubmed.ncbi.nlm.nih.gov,🎓 学术网站

  # AI
  - DOMAIN-KEYWORD,openai,🇺🇸 AI/Dev
  - DOMAIN-SUFFIX,openai.com,🇺🇸 AI/Dev
  - DOMAIN-SUFFIX,chatgpt.com,🇺🇸 AI/Dev
  - DOMAIN-SUFFIX,oaistatic.com,🇺🇸 AI/Dev
  - DOMAIN-SUFFIX,oaiusercontent.com,🇺🇸 AI/Dev
  - RULE-SET,geosite-openai,🇺🇸 AI/Dev
  - DOMAIN-KEYWORD,antigravity,🇺🇸 AI/Dev
  - DOMAIN-SUFFIX,claude.ai,🇺🇸 AI/Dev
  - DOMAIN-SUFFIX,anthropic.com,🇺🇸 AI/Dev
  - DOMAIN-SUFFIX,meta.ai,🇺🇸 AI/Dev
  - DOMAIN-SUFFIX,perplexity.ai,🇺🇸 AI/Dev
  - DOMAIN-SUFFIX,qoder.com,🇺🇸 AI/Dev

  # OneDrive：必须早于 Microsoft
  - DOMAIN-SUFFIX,onedrive.com,☁️ OneDrive
  - DOMAIN-SUFFIX,onedrive.live.com,☁️ OneDrive
  - DOMAIN-SUFFIX,1drv.com,☁️ OneDrive
  - DOMAIN-SUFFIX,sharepoint.com,☁️ OneDrive

  # GitHub：必须早于 Microsoft
  - RULE-SET,geosite-github,🔰 选择节点


  # Steam 分流（MRS 兜底 + 静态域名双保险）
  - DOMAIN-SUFFIX,steamcontent.com,🎮 Steam 登录/下载
  - DOMAIN-SUFFIX,steamcdn-a.akamaihd.net,🎮 Steam 登录/下载
  - DOMAIN-SUFFIX,steamcommunity.com,🎮 Steam 商店/社区
  - DOMAIN-SUFFIX,store.steampowered.com,🎮 Steam 商店/社区
  - RULE-SET,geosite-steam,🎮 Steam 商店/社区

  # Linux 发行版基础设施（官网/文档/社区/包仓库）
  # NixOS
  - DOMAIN-SUFFIX,nixos.org,🔰 选择节点
  - DOMAIN-SUFFIX,cache.nixos.org,🔰 选择节点
  - DOMAIN-SUFFIX,nix.dev,🔰 选择节点
  # Arch
  - DOMAIN-SUFFIX,archlinux.org,🔰 选择节点
  - DOMAIN-SUFFIX,aur.archlinux.org,🔰 选择节点
  - DOMAIN-SUFFIX,pkgbuild.com,🔰 选择节点
  # Fedora
  - DOMAIN-SUFFIX,fedoraproject.org,🔰 选择节点
  - DOMAIN-SUFFIX,fedora.org,🔰 选择节点
  - DOMAIN-SUFFIX,rpmfusion.org,🔰 选择节点
  - DOMAIN-SUFFIX,fedorainfracloud.org,🔰 选择节点
  # Ubuntu / Debian
  - DOMAIN-SUFFIX,ubuntu.com,🔰 选择节点
  - DOMAIN-SUFFIX,debian.org,🔰 选择节点
  - DOMAIN-SUFFIX,launchpad.net,🔰 选择节点
  # openSUSE
  - DOMAIN-SUFFIX,opensuse.org,🔰 选择节点
  # 通用
  - DOMAIN-SUFFIX,kernel.org,🔰 选择节点
  - DOMAIN-SUFFIX,freedesktop.org,🔰 选择节点

  # Cloudflare 站点（手动切换组 + 静态域名）
  - DOMAIN-SUFFIX,cloudflare.com,🌩️ Cloudflare
  - DOMAIN-SUFFIX,cloudflare-dns.com,🌩️ Cloudflare
  - DOMAIN-SUFFIX,cloudflareinsights.com,🌩️ Cloudflare
  - RULE-SET,geosite-cloudflare,🌩️ Cloudflare
  - DOMAIN-SUFFIX,challenges.cloudflare.com,🌩️ Cloudflare

  # 常规特定服务
  - DOMAIN-SUFFIX,noctalia.dev,🔰 选择节点
  - RULE-SET,geosite-bilibili,🌏 爱奇艺&哔哩哔哩
  - RULE-SET,geosite-bahamut,📺 动画疯
  - RULE-SET,geosite-netflix,🔰 选择节点
  - RULE-SET,geosite-youtube,🔰 选择节点
  - RULE-SET,geosite-telegram,🔰 选择节点

  # ===== 国内 =====

  - RULE-SET,geosite-cn,🇨🇳 国内网站
  - RULE-SET,geoip-cn,🇨🇳 国内网站

  # ===== 大型服务规则 =====

  - RULE-SET,geosite-microsoft,🔰 选择节点
  - RULE-SET,geosite-apple,🔰 选择节点
  - RULE-SET,geosite-google,🔰 选择节点

  # 其他国外网站兜底
  - RULE-SET,geosite-geolocation-nocn,🐟 漏网之鱼

  # 最终兜底
  - MATCH,🐟 漏网之鱼
