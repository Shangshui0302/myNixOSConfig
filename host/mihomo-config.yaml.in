external-controller: '127.0.0.1:9090'
secret: "${MIHOMO_SECRET}"

# 基础配置
mixed-port: 7890
geodata-mode: true
tcp-concurrent: true
unified-delay: true
allow-lan: false
bind-address: "127.0.0.1"
ipv6: true
log-level: info
mode: rule
keep-alive-interval: 15
inbound-tfo: true
outbound-tfo: true

# TUN
tun:
  enable: true
  device: Meta
  stack: gvisor
  mtu: 1500
  auto-route: true
  enable-ipv6: true
  auto-detect-interface: true
  dns-hijack:
    - 'any:53'

# DNS
dns:
  enable: true
  ipv6: true
  listen: 127.0.0.1:1053
  enhanced-mode: fake-ip
  use-hosts: true
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "+.*"
    - "+.lan"
    - "+.local"
    - "time.*.com"
    - "ntp.*.com"
    - "+.market.xiaomi.com"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "work.weixin.qq.com"
    - "imap.*"
  use-system-hosts: true
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - 1.1.1.1
  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
  nameserver-policy:
    '+.v51124-6.qpon': 'https://doh.pub/dns-query'
  proxy-server-nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

# Sniffer
sniffer:
  enable: true
  parse-pure-ip: true
  force-dns-mapping: false
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080, 2052, 2082, 2086, 2095]
  skip-domain:
    - +.push.apple.com
  skip-dst-address:
    - 91.105.192.0/23
    - 91.108.4.0/22
    - 91.108.8.0/21
    - 91.108.16.0/21
    - 91.108.56.0/22
    - 95.161.64.0/20
    - 149.154.160.0/20
    - 185.76.151.0/24
    - 2001:67c:4e8::/48
    - 2001:b28:f23c::/47
    - 2001:b28:f23f::/48
    - 2a0a:f280:203::/48

profile:
  store-selected: true
  store-fake-ip: true

geo-update-interval: 24
geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.metadb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

# 机场订阅（proxy: DIRECT 避免鸡生蛋：provider下载不走代理链）
proxy-providers:
  ikuuu:
    type: http
    url: "${MIHOMO_SUBSCRIPTION_URL}"
    path: ./providers/proxies.yaml
    proxy: DIRECT
    interval: 86400
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300

# 社区规则集（MetaCubeX MRS 格式，每日自动更新）
rule-providers:
  geosite-cn:
    type: http
    behavior: domain
    path: ./ruleset/geosite-cn.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/cn.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-ads:
    type: http
    behavior: domain
    path: ./ruleset/geosite-ads.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/category-ads-all.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-geolocation-nocn:
    type: http
    behavior: domain
    path: ./ruleset/geosite-geolocation-nocn.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/geolocation-!cn.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geoip-cn:
    type: http
    behavior: ipcidr
    path: ./ruleset/geoip-cn.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/cn.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-bilibili:
    type: http
    behavior: domain
    path: ./ruleset/geosite-bilibili.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/bilibili.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-bahamut:
    type: http
    behavior: domain
    path: ./ruleset/geosite-bahamut.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/bahamut.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-openai:
    type: http
    behavior: domain
    path: ./ruleset/geosite-openai.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/openai.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-netflix:
    type: http
    behavior: domain
    path: ./ruleset/geosite-netflix.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/netflix.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-youtube:
    type: http
    behavior: domain
    path: ./ruleset/geosite-youtube.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/youtube.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-google:
    type: http
    behavior: domain
    path: ./ruleset/geosite-google.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/google.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-github:
    type: http
    behavior: domain
    path: ./ruleset/geosite-github.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/github.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-microsoft:
    type: http
    behavior: domain
    path: ./ruleset/geosite-microsoft.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/microsoft.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-telegram:
    type: http
    behavior: domain
    path: ./ruleset/geosite-telegram.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/telegram.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-apple:
    type: http
    behavior: domain
    path: ./ruleset/geosite-apple.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/apple.mrs"
    format: mrs
    interval: 86400
    proxy: DIRECT

  geosite-steam:
    type: http
    behavior: domain
    path: ./ruleset/geosite-steam.mrs
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/steam.mrs"
