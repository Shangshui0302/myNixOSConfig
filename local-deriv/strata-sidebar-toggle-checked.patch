+/* A ToggleButton's :checked state is not styled for this button upstream, so the
+   system GTK theme paints it with its own accent fill while `headerbar
+   .sidebar-toggle` keeps the icon at @theme_accent.  With a pale Material 3 accent
+   (Matugen primary) the icon vanishes into that fill; mirror the app's own checked
+   language instead (cf. .preview-header-action:checked). */
+headerbar .sidebar-toggle:checked {
+  background: alpha(@theme_accent, 0.22);
+  color: @theme_accent;
+}
