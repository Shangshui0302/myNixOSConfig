@@ -0,0 +1,48 @@
+#!@NIX_PYTHON@
+"""Create first-run WeTypeX preferences without replacing user settings."""
+import argparse
+import json
+import os
+from pathlib import Path
+import tempfile
+
+
+def initialize_settings(defaults_path, config_path):
+    config_path = Path(config_path)
+    if os.path.lexists(config_path):
+        return False
+    defaults = json.loads(Path(defaults_path).read_text(encoding="utf-8"))
+    if not isinstance(defaults, dict):
+        raise ValueError("WeTypeX defaults must be a JSON object")
+    config_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    descriptor, temporary = tempfile.mkstemp(prefix=".wetypex-defaults-", dir=config_path.parent)
+    try:
+        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
+            json.dump(defaults, output, ensure_ascii=False, sort_keys=True)
+            output.write("\n")
+            output.flush()
+            os.fsync(output.fileno())
+        try:
+            # An atomic create-if-absent: concurrent launchers cannot replace a
+            # config created by the user or another launcher in the meantime.
+            os.link(temporary, config_path)
+        except FileExistsError:
+            return False
+        return True
+    finally:
+        os.unlink(temporary)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.parse_args()
+    config_home = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
+    try:
+        initialize_settings("@NIX_DEFAULT_SETTINGS@", config_home / "fcitx5/wetypex.json")
+    except (OSError, ValueError) as error:
+        parser.exit(1, "Unable to initialize WeTypeX preferences: " + str(error) + "\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
