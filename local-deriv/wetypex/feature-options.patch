+import concurrent.futures
+import importlib.util
+import json
+import os
+from pathlib import Path
+import stat
+import tempfile
+import unittest
+
+spec = importlib.util.spec_from_file_location("init_settings", Path(__file__).resolve().parents[1] / "scripts/init_settings.py")
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+class FirstRunSettingsTest(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.defaults = self.root / "defaults.json"
+        self.defaults.write_text(json.dumps({"page_size": 7, "standalone": True, "voice_microphone": "自动检测"}))
+        self.config = self.root / "config/fcitx5/wetypex.json"
+
+    def test_first_run_uses_defaults_with_private_permissions(self):
+        self.assertTrue(module.initialize_settings(self.defaults, self.config))
+        self.assertEqual(json.loads(self.config.read_text()), json.loads(self.defaults.read_text()))
+        self.assertEqual(stat.S_IMODE(self.config.stat().st_mode), 0o600)
+        self.assertEqual(list(self.config.parent.glob(".wetypex-defaults-*")), [])
+
+    def test_user_changes_survive_later_defaults_and_relaunch(self):
+        module.initialize_settings(self.defaults, self.config)
+        user = b'{"page_size":3,"standalone":false,"unknown_user_field":"keep"}\n'
+        self.config.write_bytes(user)
+        self.defaults.write_text('{"page_size":9}')
+        self.assertFalse(module.initialize_settings(self.defaults, self.config))
+        self.assertEqual(self.config.read_bytes(), user)
+
+    def test_existing_file_does_not_require_readable_defaults(self):
+        self.config.parent.mkdir(parents=True)
+        self.config.write_text("user-owned bytes, even if malformed")
+        self.assertFalse(module.initialize_settings(self.root / "missing-defaults", self.config))
+        self.assertEqual(self.config.read_text(), "user-owned bytes, even if malformed")
+
+    def test_preserves_existing_and_dangling_symlinks(self):
+        self.config.parent.mkdir(parents=True)
+        self.config.symlink_to(self.root / "not-present")
+        self.assertFalse(module.initialize_settings(self.defaults, self.config))
+        self.assertTrue(self.config.is_symlink())
+        self.assertFalse((self.root / "not-present").exists())
+
+    def test_concurrent_first_launch_has_exactly_one_writer(self):
+        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
+            results = list(pool.map(lambda _: module.initialize_settings(self.defaults, self.config), range(16)))
+        self.assertEqual(sum(results), 1)
+        self.assertEqual(json.loads(self.config.read_text()), json.loads(self.defaults.read_text()))
+        self.assertEqual(list(self.config.parent.glob(".wetypex-defaults-*")), [])
+
+    def test_invalid_defaults_leave_no_config(self):
+        self.defaults.write_text("[]")
+        with self.assertRaises(ValueError):
+            module.initialize_settings(self.defaults, self.config)
+        self.assertFalse(os.path.lexists(self.config))
+
+
+if __name__ == "__main__":
+    unittest.main()
